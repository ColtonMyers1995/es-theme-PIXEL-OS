<theme>
<view name="basic, detailed">
    <textlist name="gamelist">
      <fontPath>./assets/SST.ttf</fontPath>
      <fontSize>0.06</fontSize>
      <scrollSound>./sounds/scroll.wav</scrollSound>
      <selectSound>./sounds/select.wav</selectSound>
      <backSound>./sounds/back.wav</backSound>
      <launchSound>./sounds/launch.wav</launchSound>  
  <visible>true</visible>
      <zIndex>3</zIndex>
    </textlist>
  </view>
  <view name="basic,detailed">

<!-- SYSTEM LOGO / LABEL -->
<image name="system_logo" extra="true">
  <path>./art/${system.theme}.png</path>
  <origin>0 0</origin>
  <pos>0.02 0.08</pos>
  <maxSize>0.42 0.11</maxSize>
  <zIndex>6</zIndex>
</image>

<!-- HIDE SYSTEM TEXT -->
<text name="system_name">
  <visible>false</visible>
</text>

    <textlist name="gamelist">
<pos>0.515 0.085</pos>
<size>0.47 0.58</size>
      <alignment>left</alignment>
      <zIndex>5</zIndex>
    </textlist>
    <image name="background2" extra="true">
      <origin>0 0</origin>
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./inc/images/bg.detail.png</path>
      <zIndex>3</zIndex>
    </image>
    <image name="md_image">
      <origin>0.5 0.5</origin>
      <pos>0.251 0.72</pos>
      <size>0.47 0.465</size>
      <zIndex>5</zIndex>
    </image>
    <rating name="md_rating">
      <origin>0.5 0.5</origin>
      <zIndex>5</zIndex>
      <pos>0.266 0.435</pos>
      <size>0.054 0.054</size>
<filledPath>./inc/images/star_filled.png</filledPath>
<unfilledPath>./inc/images/star_empty.png</unfilledPath>
      <zIndex>6</zIndex>
    </rating>

    
    <text name="md_developer">
      <visible>false</visible>
      <pos>0 0</pos>
      <size>0 0</size>
    </text>

    <text name="md_publisher,md_players,md_genre">
      <visible>true</visible>
    </text>

    <datetime name="md_releasedate">
      <visible>true</visible>
    </datetime>

    <text name="md_publisher,md_developer,md_players,md_genre">
      <origin>0.5 0.5</origin>
      <size>0.6 0.6</size>
      <fontPath>./assets/SST.ttf</fontPath>
      <color>c1c1c1</color>
      <zIndex>5</zIndex>
    </text>
    <text name="md_publisher">
      <fontSize>0.026</fontSize>
      <pos>0.316 0.283</pos>
    </text>
    <text name="md_developer,md_players">
      <alignment>right</alignment>
    </text>
    <text name="md_developer">
      <pos>0.186 0.283</pos>
    </text>
    <text name="md_players">
      <pos>0.15 0.36</pos>
    </text>
    <text name="md_genre">
      <fontSize>0.026</fontSize>
      <pos>0.316 0.36</pos>
    </text>

    <text name="md_description">
      <pos>0.60 0.71</pos>
      <fontSize>0.042</fontSize>
    </text>
    <datetime name="md_releasedate">
      <fontSize>0.026</fontSize>
      <origin>0.5 0.5</origin>
      <pos>0.316 0.32</pos>
      <size>0.6 0.6</size>
      <color>c1c1c1</color>
      <format>%m/%Y</format>
      <fontPath>./assets/SST.ttf</fontPath>
      <zIndex>5</zIndex>
    </datetime>	
  </view>
 </theme>