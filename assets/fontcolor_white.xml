<theme>

<view name="menu">

    <menuText name="menutitle">
      <color>B0B0B0</color>
    </menuText>

    <menuText name="menufooter">
      <color>B0B0B0</color>
    </menuText>

    <menuText name="menutext">
      <color>FFFFFF</color>
      <selectedColor>FFFFFF</selectedColor>
    </menuText>

    <menuTextSmall name="menutextsmall">
      <color>FFFFFF</color>
    </menuTextSmall>

</view>

<view name="basic, detailed">

    <text name="system_name">
      <color>B0B0B0</color>
    </text>

    <text name="md_description">
      <color>B0B0B0</color>
    </text>

    <text name="md_name">
      <color>B0B0B0</color>
    </text>

    <text name="md_publisher">
      <color>B0B0B0</color>
    </text>

    <text name="md_developer">
      <color>B0B0B0</color>
    </text>

    <text name="md_players">
      <color>B0B0B0</color>
    </text>

    <text name="md_genre">
      <color>B0B0B0</color>
    </text>

    <text name="md_lbl_genre, md_lbl_rating, md_lbl_developer, md_lbl_publisher, md_lbl_playcount, md_lbl_releasedate">
      <color>B0B0B0</color>
    </text>

    <datetime name="md_releasedate">
      <color>B0B0B0</color>
    </datetime>

    <textlist name="gamelist">
      <primaryColor>FFFFFF</primaryColor>
      <secondaryColor>FFFFFF</secondaryColor>
      <selectedColor>FFFFFF</selectedColor>
    </textlist>

    <text name="md_lbl_lastplayed">
      <visible>false</visible>
    </text>

    <datetime name="md_lastplayed">
      <visible>false</visible>
    </datetime>

</view>

<view name="system">

    <text name="logoText">
      <color>B0B0B0</color>
    </text>

    <text name="systemInfo">
      <color>FFFFFF</color>
    </text>

</view>

<view name="screen">

    <text name="clock">
      <color>B0B0B0</color>
    </text>

</view>

</theme>
